[gd_resource type="ShaderMaterial" format=3]

[sub_resource type="Shader" id="Shader_fairytale_mountains"]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

// Fairy-tale Lush Green Mountains Shader
uniform vec4 grass_color : source_color = vec4(0.24, 0.62, 0.18, 1.0);
uniform vec4 grass_highlight : source_color = vec4(0.42, 0.78, 0.25, 1.0);
uniform vec4 rock_color : source_color = vec4(0.44, 0.36, 0.28, 1.0);
uniform vec4 rock_shadow : source_color = vec4(0.28, 0.23, 0.18, 1.0);
uniform vec4 valley_moss : source_color = vec4(0.12, 0.38, 0.14, 1.0);

uniform float slope_threshold : hint_range(-1.0, 1.0) = 0.32;
uniform float slope_softness : hint_range(0.01, 1.0) = 0.22;
uniform float grass_roughness : hint_range(0.0, 1.0) = 0.75;
uniform float rock_roughness : hint_range(0.0, 1.0) = 0.88;
uniform float uv_scale : hint_range(0.01, 10.0) = 0.08;
uniform float triplanar_sharpness : hint_range(1.0, 16.0) = 4.0;

varying vec3 v_world_pos;
varying vec3 v_world_normal;

void vertex() {
	v_world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	v_world_normal = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

vec3 get_triplanar_weights(vec3 n) {
	vec3 w = pow(abs(n), vec3(triplanar_sharpness));
	return w / (w.x + w.y + w.z);
}

void fragment() {
	float slope = v_world_normal.y;
	float grass_factor = smoothstep(
		slope_threshold - slope_softness,
		slope_threshold + slope_softness,
		slope
	);
	
	// Triplanar noise sampling for natural rock & grass variation
	vec3 w = get_triplanar_weights(v_world_normal);
	vec2 uv_x = v_world_pos.zy * uv_scale;
	vec2 uv_y = v_world_pos.xz * uv_scale;
	vec2 uv_z = v_world_pos.xy * uv_scale;
	
	// Multi-octave procedural stratification
	float rock_strata = sin(v_world_pos.y * 0.35 + sin(v_world_pos.x * 0.1) * 2.0) * 0.5 + 0.5;
	float fine_noise = 0.5 + 0.5 * (
		sin(uv_x.x * 6.28) * sin(uv_x.y * 6.28) * w.x +
		sin(uv_y.x * 6.28) * sin(uv_y.y * 6.28) * w.y +
		sin(uv_z.x * 6.28) * sin(uv_z.y * 6.28) * w.z
	);
	
	// Rich Cliff rock blending
	vec3 final_rock = mix(rock_shadow.rgb, rock_color.rgb, rock_strata * 0.6 + fine_noise * 0.4);
	
	// Lush Grass variation with sunlit highlights
	float height_fade = clamp((v_world_pos.y + 10.0) / 80.0, 0.0, 1.0);
	vec3 base_grass = mix(valley_moss.rgb, grass_color.rgb, height_fade);
	vec3 final_grass = mix(base_grass, grass_highlight.rgb, fine_noise * 0.45);
	
	// Final composite
	ALBEDO = mix(final_rock, final_grass, grass_factor);
	ROUGHNESS = mix(rock_roughness, grass_roughness, grass_factor);
	METALLIC = 0.02;
	SPECULAR = mix(0.25, 0.4, grass_factor);
}
"

[resource]
render_priority = 0
shader = SubResource("Shader_fairytale_mountains")
shader_parameter/grass_color = Color(0.24, 0.62, 0.18, 1)
shader_parameter/grass_highlight = Color(0.42, 0.78, 0.25, 1)
shader_parameter/rock_color = Color(0.46, 0.38, 0.30, 1)
shader_parameter/rock_shadow = Color(0.28, 0.23, 0.18, 1)
shader_parameter/valley_moss = Color(0.12, 0.38, 0.14, 1)
shader_parameter/slope_threshold = 0.32
shader_parameter/slope_softness = 0.22
shader_parameter/grass_roughness = 0.75
shader_parameter/rock_roughness = 0.88
shader_parameter/uv_scale = 0.08
shader_parameter/triplanar_sharpness = 4.0
